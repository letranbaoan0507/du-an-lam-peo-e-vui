# Server only. Supabase Connect > Transaction pooler; không đưa URL này vào frontend.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# Dán CA từ Supabase Settings > Database; JSON/string PEM có thể dùng ký tự \n.
DATABASE_SSL_CA=
# Máy local PostgreSQL không TLS: đặt true chỉ cho localhost, mặc định false.
DATABASE_LOCAL_NO_TLS=false
APP_URL=http://localhost:3000
# Tùy chọn; chưa cấu hình thì API email báo lỗi rõ ràng.
RESEND_API_KEY=
EMAIL_FROM=
